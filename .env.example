# Reference only. `.github/workflows/deploy.yml` renders the real `.env` on the VPS from this
# repo's secrets on every run, and hand edits on the box are reverted by the next deploy.
# See VPS_SETUP.md §6 for what each value is and where it comes from.
#
# Compose eats an unquoted `$` and its dotenv parser has no escape for `'`. The workflow
# renders every credential single-quoted and rejects any secret containing a single quote.
# `openssl rand -base64 32` emits neither.

REGISTRY=southamerica-east1-docker.pkg.dev/CHANGE_ME_PROJECT_ID/auth
AUTH_TAG=CHANGE_ME

KC_DB_PASSWORD=CHANGE_ME

KC_ADMIN=CHANGE_ME
KC_ADMIN_PASSWORD=CHANGE_ME

# Shared with planelyx-infra — both repos must hold the same value.
KEYCLOAK_ADMIN_CLIENT_SECRET=CHANGE_ME
PLANELYX_PROVISIONING_SECRET=CHANGE_ME

AUTH_LOG_LEVEL=info
