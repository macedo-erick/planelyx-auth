{
  "realm": "planelyx",
  "enabled": true,
  "displayName": "Planelyx",
  "displayNameHtml": "Planelyx",
  "loginTheme": "planelyx",
  "sslRequired": "external",
  "accessTokenLifespan": 3600,
  "registrationAllowed": true,
  "registrationEmailAsUsername": false,
  "resetPasswordAllowed": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "verifyEmail": false,
  "passwordPolicy": "length(12) and digits(1) and lowerCase(1) and upperCase(1) and specialChars(1) and notUsername and notEmail",
  "clients": [
    {
      "clientId": "planelyx-api",
      "enabled": true,
      "publicClient": true,
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": true,
      "serviceAccountsEnabled": false,
      "rootUrl": "${PLANELYX_UI_BASE_URL:http://localhost:4200}",
      "redirectUris": [
        "${PLANELYX_UI_BASE_URL:http://localhost:4200}/*"
      ],
      "webOrigins": [
        "${PLANELYX_UI_ORIGIN:http://localhost:4200}"
      ],
      "attributes": {
        "post.logout.redirect.uris": "${PLANELYX_UI_BASE_URL:http://localhost:4200}/*"
      }
    },
    {
      "clientId": "planelyx-api-admin",
      "enabled": true,
      "description": "Service account the API uses to read and update the signed-in user's own profile.",
      "publicClient": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "secret": "${PLANELYX_KEYCLOAK_ADMIN_CLIENT_SECRET:local-dev-secret}"
    }
  ],
  "users": [
    {
      "username": "service-account-planelyx-api-admin",
      "enabled": true,
      "serviceAccountClientId": "planelyx-api-admin",
      "clientRoles": {
        "realm-management": [
          "view-users",
          "manage-users"
        ]
      }
    }
  ]
}
